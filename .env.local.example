# Server Configuration
# PORT=3015

# Client URL (for CORS and API calls)
# CLIENT_URL=http://localhost:3000

# PostgreSQL Database (for Record Store)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=clown_club
# DB_USER=postgres
# DB_PASSWORD=your_password

# Spotify DJ Booth (auto-generated by npm run spotify:setup in joey-musselman-site)
# Copy this from joey-musselman-site/.env.local after running setup
# SPOTIFY_REFRESH_TOKEN=your_refresh_token
